---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PayhipProductCard from '../../components/PayhipProductCard.astro';

const products = await getCollection('products');
---

<BaseLayout title="Digital Store | Fluent Voice & Play Sounds With Imelda">
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-fv-primary mb-3">
        Digital Workbooks, Audio Guides & Phonics Packs
      </h1>
      <p class="text-fv-dark/75">
        Instant digital downloads for spoken English mastery and early childhood synthetic phonics. Secure checkout powered by Payhip.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((item) => (
        <PayhipProductCard {...item.data} />
      ))}
    </div>
  </section>
</BaseLayout>