---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoCard from '../../components/VideoCard.astro';
import PayhipProductCard from '../../components/PayhipProductCard.astro';

const kidsLessons = await getCollection('play-sounds');
const products = await getCollection('products');
const kidsProducts = products.filter((p) => p.data.brand === 'play-sounds');
---

<BaseLayout
  title="Play Sounds With Imelda | Fun Phonics & CVC Blending for Kids"
  brandMode="play-sounds"
>
  <section class="bg-gradient-to-b from-ps-sky/40 to-transparent py-14 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block px-4 py-1 rounded-full bg-ps-pink text-fv-dark font-bold text-xs mb-3">
        A Fluent Voice with Imelda Kids Studio
      </span>
      <h1 class="text-3xl sm:text-5xl font-bold text-fv-primary mb-4">
        Play Sounds With Imelda
      </h1>
      <p class="text-fv-dark/80 text-base sm:text-lg max-w-2xl mx-auto">
        Learn letter sounds, blend CVC words, and sing along with Imelda, Cleo, Max, and Barnaby!
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 mt-6">
    <h2 class="text-2xl font-bold text-fv-primary mb-6">Phonics Video Adventures</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {kidsLessons.map((lesson) => (
        <VideoCard {...lesson.data} isKids={true} />
      ))}
    </div>
  </section>

  {kidsProducts.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 mt-16">
      <h2 class="text-2xl font-bold text-fv-primary mb-6">Printable CVC Worksheets & Packs</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {kidsProducts.map((item) => (
          <PayhipProductCard {...item.data} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>