---
interface Props {
  title: string;
  description: string;
  youtubeId: string;
  moduleTag: string;
  worksheetUrl?: string;
  isKids?: boolean;
}

const { title, description, youtubeId, moduleTag, worksheetUrl, isKids = false } = Astro.props;
---

<article
  class={`rounded-2xl overflow-hidden border bg-white shadow-xs flex flex-col justify-between ${
    isKids ? 'border-ps-sky border-2' : 'border-black/10'
  }`}
>
  <div>
    <div class="aspect-video w-full bg-black">
      <iframe
        class="w-full h-full"
        src={`https://www.youtube.com/embed/${youtubeId}`}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
    <div class="p-5">
      <span
        class={`inline-block text-xs font-bold px-2.5 py-1 rounded-full mb-2 ${
          isKids ? 'bg-ps-mint text-fv-dark' : 'bg-fv-secondary text-fv-primary'
        }`}
      >
        {moduleTag}
      </span>
      <h3 class="text-lg font-bold text-fv-primary mb-1">{title}</h3>
      <p class="text-sm text-fv-dark/75 leading-relaxed">{description}</p>
    </div>
  </div>

  {worksheetUrl && (
    <div class="px-5 pb-5">
      <a
        href={worksheetUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block w-full text-center text-sm font-semibold py-2 px-4 rounded-xl bg-fv-secondary text-fv-primary hover:bg-fv-accent/30 transition"
      >
        Download Companion Resource
      </a>
    </div>
  )}
</article>