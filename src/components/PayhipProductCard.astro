---
interface Props {
  title: string;
  brand: 'fluent-voice' | 'play-sounds';
  priceDisplay: string;
  description: string;
  format: string;
  payhipId: string;
}

const { title, brand, priceDisplay, description, format, payhipId } = Astro.props;
const isKids = brand === 'play-sounds';
---

<div
  class={`rounded-2xl p-6 bg-white border flex flex-col justify-between shadow-xs ${
    isKids ? 'border-ps-pink border-2' : 'border-fv-primary/15'
  }`}
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <span
        class={`text-xs font-bold px-3 py-1 rounded-full ${
          isKids ? 'bg-ps-pink/40 text-fv-dark font-kids' : 'bg-fv-primary text-white'
        }`}
      >
        {isKids ? 'Play Sounds With Imelda' : 'Fluent Voice'}
      </span>
      <span class="text-xs font-semibold text-fv-dark/60">{format}</span>
    </div>

    <h3 class={`text-xl font-bold text-fv-primary mb-2 ${isKids ? 'font-kids' : ''}`}>
      {title}
    </h3>
    <p class="text-sm text-fv-dark/75 mb-4 leading-relaxed">{description}</p>
  </div>

  <div class="pt-4 border-t border-black/5 flex items-center justify-between gap-3">
    <span class="text-lg font-bold text-fv-primary">{priceDisplay}</span>
    <a
      href={`https://payhip.com/buy?link=${payhipId}`}
      class="payhip-buy-button px-5 py-2.5 rounded-xl font-bold text-sm bg-fv-primary text-white hover:bg-fv-dark transition"
      data-theme="none"
      data-product={payhipId}
    >
      Buy Instant Download
    </a>
  </div>
</div>